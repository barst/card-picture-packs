{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game.cbo.com.tw/picture-packs/schemas/localized-text.schema.json",
  "title": "拾光拼圖四語文字",
  "type": "object",
  "additionalProperties": false,
  "required": ["zh-TW", "zh-CN", "en", "ja"],
  "properties": {
    "zh-TW": { "type": "string", "minLength": 1 },
    "zh-CN": { "type": "string", "minLength": 1 },
    "en": { "type": "string", "minLength": 1 },
    "ja": { "type": "string", "minLength": 1 }
  }
}
