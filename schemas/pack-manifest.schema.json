{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game.cbo.com.tw/picture-packs/schemas/pack-manifest.schema.json",
  "title": "拾光拼圖單一圖庫描述檔",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "version", "order", "releasedAt", "price", "defaultLocale", "supportedLocales", "title", "description", "artwork", "coverImageId", "images"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "packId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "order": { "type": "integer", "minimum": 0 },
    "releasedAt": { "type": "string", "format": "date-time" },
    "price": { "type": "integer", "minimum": 0 },
    "defaultLocale": { "const": "zh-TW" },
    "supportedLocales": {
      "type": "array",
      "prefixItems": [{ "const": "zh-TW" }, { "const": "zh-CN" }, { "const": "en" }, { "const": "ja" }],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "title": { "$ref": "localized-text.schema.json" },
    "description": { "$ref": "localized-text.schema.json" },
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation", "aspectRatio"],
      "properties": {
        "orientation": { "const": "portrait" },
        "aspectRatio": { "const": "3:4" }
      }
    },
    "coverImageId": { "type": "string", "minLength": 1 },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "mimeType", "width", "height", "bytes", "sha256", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(?:-[a-z0-9_-]+)*$" },
          "file": { "type": "string", "pattern": "^packs/[a-z0-9-]+/v[1-9][0-9]*/images/[^/]+\\.webp$" },
          "mimeType": { "const": "image/webp" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "name": { "$ref": "localized-text.schema.json" }
        }
      }
    }
  }
}
